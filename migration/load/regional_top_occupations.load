load csv
    from 'regional_top_occupations.csv'
    (
        noc,
        occupation,
        openings,
        region
    )
    into postgresql:///ssot
    target table regional_top_occupations
    target columns
    (
        region,
        noc text using (trim-hash noc),
        occupation,
        openings
    )
    with
        fields optionally enclosed by '"',
        fields terminated by ',',
        drop indexes

    before load do
    $$ drop table if exists regional_top_occupations; $$,
    $$ create table if not exists regional_top_occupations
    (
        region citext,
        noc text,
        occupation text,
        openings int,
        primary key(region, noc)
    );
    $$

    after load do
    $$ update regional_top_occupations set region = normalize_region_name(region); $$,
    $$ comment on table regional_top_occupations is 'WorkBC Regional Profile Data {2026-2036} > Top 10 Occupations by region'; $$,
    $$ comment on column regional_top_occupations.region is 'Region'; $$,
    $$ comment on column regional_top_occupations.noc is 'NOC'; $$,
    $$ comment on column regional_top_occupations.occupation is 'Occupation'; $$,
    $$ comment on column regional_top_occupations.openings is 'Job Openings {2026-2036}'; $$
;
