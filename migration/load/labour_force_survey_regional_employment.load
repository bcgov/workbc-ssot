load csv
    from 'labour_force_survey_regional_employment.csv'
    (
        region,
        age_distribution_0_14 [null if '__SSOT_NULL__'],
        age_distribution_15_24 [null if '__SSOT_NULL__'],
        age_distribution_25_54 [null if '__SSOT_NULL__'],
        age_distribution_55_64 [null if '__SSOT_NULL__'],
        age_distribution_65 [null if '__SSOT_NULL__'],
        full_time_employment_pct [null if '__SSOT_NULL__'],
        full_time_employment_num [null if '__SSOT_NULL__'],
        unemployment_rate_year_1 [null if '__SSOT_NULL__'],
        unemployment_rate_year_2 [null if '__SSOT_NULL__'],
        unemployment_rate_year_3 [null if '__SSOT_NULL__'],
        unemployment_rate_year_4 [null if '__SSOT_NULL__'],
        unemployment_rate_year_5 [null if '__SSOT_NULL__'],
        unemployment_rate_year_6 [null if '__SSOT_NULL__'],
        unemployment_rate_year_7 [null if '__SSOT_NULL__'],
        unemployment_rate_year_8 [null if '__SSOT_NULL__'],
        unemployment_rate_year_9 [null if '__SSOT_NULL__'],
        unemployment_rate_year_10 [null if '__SSOT_NULL__'],
        unemployment_rate_year_11 [null if '__SSOT_NULL__'],
        unemployment_rate_year_low [null if '__SSOT_NULL__'],
        unemployment_rate_year_high [null if '__SSOT_NULL__'],
        unemployment_rate_year_avg [null if '__SSOT_NULL__']
    )
    into postgresql:///ssot
    target table labour_force_survey_regional_employment
    target columns
    (
        region,
        age_distribution_0_14,
        age_distribution_15_24,
        age_distribution_25_54,
        age_distribution_55_64,
        age_distribution_65,
        full_time_employment_pct,
        full_time_employment_num,
        unemployment_rate_year_1,
        unemployment_rate_year_2,
        unemployment_rate_year_3,
        unemployment_rate_year_4,
        unemployment_rate_year_5,
        unemployment_rate_year_6,
        unemployment_rate_year_7,
        unemployment_rate_year_8,
        unemployment_rate_year_9,
        unemployment_rate_year_10,
        unemployment_rate_year_11,
        unemployment_rate_year_low,
        unemployment_rate_year_high,
        unemployment_rate_year_avg
    )
    with
        fields optionally enclosed by '"',
        fields terminated by ',',
        drop indexes

    before load do
    $$ drop table if exists labour_force_survey_regional_employment; $$,
    $$ create table if not exists labour_force_survey_regional_employment
    (
        region citext primary key,
        age_distribution_0_14 numeric,
        age_distribution_15_24 numeric,
        age_distribution_25_54 numeric,
        age_distribution_55_64 numeric,
        age_distribution_65 numeric,
        total_employment_num numeric,
        full_time_employment_pct numeric,
        full_time_employment_num numeric,
        part_time_employment_pct numeric,
        part_time_employment_num numeric,
        unemployment_rate_year_1 numeric,
        unemployment_rate_year_2 numeric,
        unemployment_rate_year_3 numeric,
        unemployment_rate_year_4 numeric,
        unemployment_rate_year_5 numeric,
        unemployment_rate_year_6 numeric,
        unemployment_rate_year_7 numeric,
        unemployment_rate_year_8 numeric,
        unemployment_rate_year_9 numeric,
        unemployment_rate_year_10 numeric,
        unemployment_rate_year_11 numeric,
        unemployment_rate_year_low numeric,
        unemployment_rate_year_high numeric,
        unemployment_rate_year_avg numeric
    );
    $$

    after load do
    $$ update labour_force_survey_regional_employment set total_employment_num = full_time_employment_num * 100 / full_time_employment_pct; $$,
    $$ update labour_force_survey_regional_employment set part_time_employment_pct = 100 - full_time_employment_pct; $$,
    $$ update labour_force_survey_regional_employment set part_time_employment_num = total_employment_num * part_time_employment_pct / 100; $$,
    $$ update labour_force_survey_regional_employment set region = normalize_region_name(region); $$,
    $$ comment on table labour_force_survey_regional_employment is 'LFS Data Sheet {0} > Regional Profiles > Table 1'; $$,
    $$ comment on column labour_force_survey_regional_employment.region is 'Region'; $$,
    $$ comment on column labour_force_survey_regional_employment.age_distribution_0_14 is 'Population Distribution > Age distribution > 0-14'; $$,
    $$ comment on column labour_force_survey_regional_employment.age_distribution_15_24 is 'Population Distribution > Age distribution > 15-24'; $$,
    $$ comment on column labour_force_survey_regional_employment.age_distribution_25_54 is 'Population Distribution > Age distribution > 25-54'; $$,
    $$ comment on column labour_force_survey_regional_employment.age_distribution_55_64 is 'Population Distribution > Age distribution > 55-64'; $$,
    $$ comment on column labour_force_survey_regional_employment.age_distribution_65 is 'Population Distribution > Age distribution > 65+'; $$,
    $$ comment on column labour_force_survey_regional_employment.total_employment_num is 'Employment statistics > Regional total employment {0} > Number'; $$,
    $$ comment on column labour_force_survey_regional_employment.full_time_employment_pct is 'Employment statistics > Regional full-time employment > %'; $$,
    $$ comment on column labour_force_survey_regional_employment.full_time_employment_num is 'Employment statistics > Regional full-time employment > Number'; $$,
    $$ comment on column labour_force_survey_regional_employment.part_time_employment_pct is 'Employment statistics > Regional part-time employment > %'; $$,
    $$ comment on column labour_force_survey_regional_employment.part_time_employment_num is 'Employment statistics > Regional part-time employment > Number'; $$,
    $$ comment on column labour_force_survey_regional_employment.unemployment_rate_year_1 is 'Employment statistics > Unemployment rate > 10-year unemployment rate (2014-2024) > {-10}'; $$,
    $$ comment on column labour_force_survey_regional_employment.unemployment_rate_year_2 is 'Employment statistics > Unemployment rate > 10-year unemployment rate (2014-2024) > {-9}'; $$,
    $$ comment on column labour_force_survey_regional_employment.unemployment_rate_year_3 is 'Employment statistics > Unemployment rate > 10-year unemployment rate (2014-2024) > {-8}'; $$,
    $$ comment on column labour_force_survey_regional_employment.unemployment_rate_year_4 is 'Employment statistics > Unemployment rate > 10-year unemployment rate (2014-2024) > {-7}'; $$,
    $$ comment on column labour_force_survey_regional_employment.unemployment_rate_year_5 is 'Employment statistics > Unemployment rate > 10-year unemployment rate (2014-2024) > {-6}'; $$,
    $$ comment on column labour_force_survey_regional_employment.unemployment_rate_year_6 is 'Employment statistics > Unemployment rate > 10-year unemployment rate (2014-2024) > {-5}'; $$,
    $$ comment on column labour_force_survey_regional_employment.unemployment_rate_year_7 is 'Employment statistics > Unemployment rate > 10-year unemployment rate (2014-2024) > {-4}'; $$,
    $$ comment on column labour_force_survey_regional_employment.unemployment_rate_year_8 is 'Employment statistics > Unemployment rate > 10-year unemployment rate (2014-2024) > {-3}'; $$,
    $$ comment on column labour_force_survey_regional_employment.unemployment_rate_year_9 is 'Employment statistics > Unemployment rate > 10-year unemployment rate (2014-2024) > {-2}'; $$,
    $$ comment on column labour_force_survey_regional_employment.unemployment_rate_year_10 is 'Employment statistics > Unemployment rate > 10-year unemployment rate (2014-2024) > {-1}'; $$,
    $$ comment on column labour_force_survey_regional_employment.unemployment_rate_year_11 is 'Employment statistics > Unemployment rate > 10-year unemployment rate (2014-2024) > {0}'; $$,
    $$ comment on column labour_force_survey_regional_employment.unemployment_rate_year_low is 'Employment statistics > Unemployment rate > 10-year unemployment rate (2014-2024) > Low'; $$,
    $$ comment on column labour_force_survey_regional_employment.unemployment_rate_year_high is 'Employment statistics > Unemployment rate > 10-year unemployment rate (2014-2024) > High'; $$,
    $$ comment on column labour_force_survey_regional_employment.unemployment_rate_year_avg is 'Employment statistics > Unemployment rate > 10-year unemployment rate (2014-2024) > Avg'; $$
;
