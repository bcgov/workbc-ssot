load csv
    from 'career_regional.csv'
    (
        noc,
        description,
        cariboo_employment_current [null if '__SSOT_NULL__'],
        cariboo_average_annual_employment_growth_10y_pct [null if '__SSOT_NULL__'],
        cariboo_expected_number_of_job_openings_10y [null if '__SSOT_NULL__'],
        blank_1,
        kootenay_employment_current [null if '__SSOT_NULL__'],
        kootenay_average_annual_employment_growth_10y_pct [null if '__SSOT_NULL__'],
        kootenay_expected_number_of_job_openings_10y [null if '__SSOT_NULL__'],
        blank_2,
        mainland_southwest_employment_current [null if '__SSOT_NULL__'],
        mainland_southwest_annual_employment_growth_10y_pct [null if '__SSOT_NULL__'],
        mainland_southwest_expected_number_of_job_openings_10y [null if '__SSOT_NULL__'],
        blank_3,
        north_coast_nechako_employment_current [null if '__SSOT_NULL__'],
        north_coast_nechako_annual_employment_growth_10y_pct [null if '__SSOT_NULL__'],
        north_coast_nechako_expected_number_of_job_openings_10y [null if '__SSOT_NULL__'],
        blank_4,
        northeast_employment_current [null if '__SSOT_NULL__'],
        northeast_annual_employment_growth_10y_pct [null if '__SSOT_NULL__'],
        northeast_expected_number_of_job_openings_10y [null if '__SSOT_NULL__'],
        blank_5,
        thompson_okanagan_employment_current [null if '__SSOT_NULL__'],
        thompson_okanagan_annual_employment_growth_10y_pct [null if '__SSOT_NULL__'],
        thompson_okanagan_expected_number_of_job_openings_10y [null if '__SSOT_NULL__'],
        blank_6,
        vancouver_island_coast_employment_current [null if '__SSOT_NULL__'],
        vancouver_island_coast_annual_employment_growth_10y_pct [null if '__SSOT_NULL__'],
        vancouver_island_coast_expected_number_of_job_openings_10y [null if '__SSOT_NULL__']
    )
    into postgresql:///ssot
    target table career_regional
    target columns
    (
        noc,
        description,
        cariboo_employment_current,
        cariboo_average_annual_employment_growth_10y_pct,
        cariboo_expected_number_of_job_openings_10y,
        kootenay_employment_current,
        kootenay_average_annual_employment_growth_10y_pct,
        kootenay_expected_number_of_job_openings_10y,
        mainland_southwest_employment_current,
        mainland_southwest_annual_employment_growth_10y_pct,
        mainland_southwest_expected_number_of_job_openings_10y,
        north_coast_nechako_employment_current,
        north_coast_nechako_annual_employment_growth_10y_pct,
        north_coast_nechako_expected_number_of_job_openings_10y,
        northeast_employment_current,
        northeast_annual_employment_growth_10y_pct,
        northeast_expected_number_of_job_openings_10y,
        thompson_okanagan_employment_current,
        thompson_okanagan_annual_employment_growth_10y_pct,
        thompson_okanagan_expected_number_of_job_openings_10y,
        vancouver_island_coast_employment_current,
        vancouver_island_coast_annual_employment_growth_10y_pct,
        vancouver_island_coast_expected_number_of_job_openings_10y
    )
    with
        fields optionally enclosed by '"',
        fields terminated by ',',
        drop indexes

    before load do
    $$ drop table if exists career_regional; $$,
    $$ create table if not exists career_regional
    (
        noc text primary key,
        description text,
        cariboo_employment_current int,
        cariboo_average_annual_employment_growth_10y_pct numeric,
        cariboo_expected_number_of_job_openings_10y int,
        kootenay_employment_current int,
        kootenay_average_annual_employment_growth_10y_pct numeric,
        kootenay_expected_number_of_job_openings_10y int,
        mainland_southwest_employment_current int,
        mainland_southwest_annual_employment_growth_10y_pct numeric,
        mainland_southwest_expected_number_of_job_openings_10y int,
        north_coast_nechako_employment_current int,
        north_coast_nechako_annual_employment_growth_10y_pct numeric,
        north_coast_nechako_expected_number_of_job_openings_10y int,
        northeast_employment_current int,
        northeast_annual_employment_growth_10y_pct numeric,
        northeast_expected_number_of_job_openings_10y int,
        thompson_okanagan_employment_current int,
        thompson_okanagan_annual_employment_growth_10y_pct numeric,
        thompson_okanagan_expected_number_of_job_openings_10y int,
        vancouver_island_coast_employment_current int,
        vancouver_island_coast_annual_employment_growth_10y_pct numeric,
        vancouver_island_coast_expected_number_of_job_openings_10y int
    );
    $$

    after load do
    $$ comment on table career_regional is 'WorkBC Career Profile Data {2026-2036} > Regional Outlook'; $$,
    $$ comment on column career_regional.noc is 'NOC'; $$,
    $$ comment on column career_regional.description is 'Occupation'; $$,
    $$ comment on column career_regional.cariboo_employment_current is 'Cariboo > Employment in {2026}'; $$,
    $$ comment on column career_regional.cariboo_average_annual_employment_growth_10y_pct is 'Caribo > Average annual employment growth (%) {2026-2036}'; $$,
    $$ comment on column career_regional.cariboo_expected_number_of_job_openings_10y is 'Cariboo > Expected number of job openings {2026-2036}'; $$,
    $$ comment on column career_regional.kootenay_employment_current is 'Kootenay > Employment in {2026}'; $$,
    $$ comment on column career_regional.kootenay_average_annual_employment_growth_10y_pct is 'Kootenay > Average annual employment growth (%) {2026-2036}'; $$,
    $$ comment on column career_regional.kootenay_expected_number_of_job_openings_10y is 'Kootenay > Expected number of job openings {2026-2036}'; $$,
    $$ comment on column career_regional.mainland_southwest_employment_current is 'Mainland/Southwest > Employment in {2026}'; $$,
    $$ comment on column career_regional.mainland_southwest_annual_employment_growth_10y_pct is 'Mainland/Southwest > Average annual employment growth (%) {2026-2036}'; $$,
    $$ comment on column career_regional.mainland_southwest_expected_number_of_job_openings_10y is 'Mainland/Southwest > Expected number of job openings {2026-2036}'; $$,
    $$ comment on column career_regional.north_coast_nechako_employment_current is 'North Coast and Nechako > Employment in {2026}'; $$,
    $$ comment on column career_regional.north_coast_nechako_annual_employment_growth_10y_pct is 'North Coast and Nechako > Average annual employment growth (%) {2026-2036}'; $$,
    $$ comment on column career_regional.north_coast_nechako_expected_number_of_job_openings_10y is 'North Coast and Nechako > Expected number of job openings {2026-2036}'; $$,
    $$ comment on column career_regional.northeast_employment_current is 'Northeast > Employment in {2026}'; $$,
    $$ comment on column career_regional.northeast_annual_employment_growth_10y_pct is 'Northeast > Average annual employment growth (%) {2026-2036}'; $$,
    $$ comment on column career_regional.northeast_expected_number_of_job_openings_10y is 'Northeast > Expected number of job openings {2026-2036}'; $$,
    $$ comment on column career_regional.thompson_okanagan_employment_current is 'Thompson-Okanagan > Employment in {2026}'; $$,
    $$ comment on column career_regional.thompson_okanagan_annual_employment_growth_10y_pct is 'Thompson-Okanagan > Average annual employment growth (%) {2026-2036}'; $$,
    $$ comment on column career_regional.thompson_okanagan_expected_number_of_job_openings_10y is 'Thompson-Okanagan > Expected number of job openings {2026-2036}'; $$,
    $$ comment on column career_regional.vancouver_island_coast_employment_current is 'Vancouver Island/Coast > Employment in {2026}'; $$,
    $$ comment on column career_regional.vancouver_island_coast_annual_employment_growth_10y_pct is 'Vancouver Island/Coast > Average annual employment growth (%) {2026-2036}'; $$,
    $$ comment on column career_regional.vancouver_island_coast_expected_number_of_job_openings_10y is 'Vancouver Island/Coast > Expected number of job openings {2026-2036}'; $$
;
